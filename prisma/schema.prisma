generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id             String          @id @default(cuid())
  phoneNumber    String          @unique
  employeeCode   String?         @unique
  name           String
  supervisorName String?
  bpName         String?
  active         Boolean         @default(true)
  retailers      Retailer[]
  targets        MonthlyTarget[]
  manualMetrics  ManualMetric[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Retailer {
  id             String      @id @default(cuid())
  retailerCode   String      @unique
  retailerName   String?
  itopupNumber   String?
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  active         Boolean     @default(true)
  gaRecords      GaRecord[]
  c2cRecords     C2cRecord[]
  c2sRecords     C2sRecord[]
  obRecords      ObRecord[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([employeeId])
}

model MonthlyTarget {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  month               DateTime
  gaTarget            Int      @default(0)
  c2cTarget           Decimal  @default(0) @db.Decimal(18,2)
  scTarget            Decimal  @default(0) @db.Decimal(18,2)
  totalRechargeTarget Decimal  @default(0) @db.Decimal(18,2)
  ssoTarget           Int      @default(0)
  lsoTarget           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([month])
}

model ManualMetric {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      DateTime
  scAchieved Decimal  @default(0) @db.Decimal(18,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, month])
}

model ImportBatch {
  id          String      @id @default(cuid())
  type        ImportType
  fileName    String
  businessDate DateTime?
  uploadedAt  DateTime    @default(now())
  totalRows   Int         @default(0)
  successRows Int         @default(0)
  failedRows  Int         @default(0)
  hash        String?     @unique
  status      ImportStatus @default(PROCESSING)
  errors      ImportError[]
  gaRecords   GaRecord[]
  c2cRecords  C2cRecord[]
  c2sRecords  C2sRecord[]
  obRecords   ObRecord[]
}

model ImportError {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  message   String
  rawData   Json?
  createdAt DateTime    @default(now())
}

model GaRecord {
  id         String      @id @default(cuid())
  retailerId String
  retailer   Retailer    @relation(fields: [retailerId], references: [id])
  date       DateTime
  gaCount    Int         @default(0)
  ga150      Int         @default(0)
  ga300      Int         @default(0)
  batchId    String?
  batch      ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

model C2cRecord {
  id               String      @id @default(cuid())
  retailerId       String
  retailer         Retailer    @relation(fields: [retailerId], references: [id])
  date             DateTime
  transactionCount Int         @default(0)
  amount           Decimal     @default(0) @db.Decimal(18,2)
  batchId          String?
  batch             ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt        DateTime    @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

model C2sRecord {
  id               String      @id @default(cuid())
  retailerId       String
  retailer         Retailer    @relation(fields: [retailerId], references: [id])
  date             DateTime
  transactionCount Int         @default(0)
  amount           Decimal     @default(0) @db.Decimal(18,2)
  enabled          Boolean?
  sellerStatus     String?
  batchId          String?
  batch             ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt        DateTime    @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

model ObRecord {
  id               String      @id @default(cuid())
  retailerId       String
  retailer         Retailer    @relation(fields: [retailerId], references: [id])
  date             DateTime
  transactionCount Int         @default(0)
  amount           Decimal     @default(0) @db.Decimal(18,2)
  batchId          String?
  batch             ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt        DateTime    @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

enum ImportType {
  GA
  C2C
  C2S
  OB
  EMPLOYEES
  RETAILERS
  TARGETS
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}
