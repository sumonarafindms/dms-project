generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

model Supervisor {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?
}

model Employee {
  id            String          @id @default(cuid())
  rsoMsisdn     String          @unique
  employeeCode  String?         @unique
  name          String
  supervisorId  String?
  supervisor    Supervisor?     @relation(fields: [supervisorId], references: [id])
  active        Boolean         @default(true)
  retailers     Retailer[]
  targets       MonthlyTarget[]
  manualMetrics ManualMetric[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?
  bpAssignments BpAssignment[]

  @@index([supervisorId])
}

model Retailer {
  id               String      @id @default(cuid())
  retailerCode     String      @unique
  retailerName     String?
  simSeller        String?
  iTopUpSeller     String?
  tranMobileNo     String?
  iTopUpSrNumber   String?
  iTopUpNumber     String?
  category         String?
  rsoCode          String?
  route             String?
  employeeId       String?
  employee         Employee?   @relation(fields: [employeeId], references: [id])
  active            Boolean     @default(true)
  gaRecords         GaRecord[]
  gaActivations     GaActivation[]
  c2cRecords        C2cRecord[]
  c2sRecords        C2sRecord[]
  obRecords         ObRecord[]
  bpAssignments     BpAssignment[]
  bpUser            User?           @relation("BpRetailerUser")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([employeeId])
  @@index([iTopUpSrNumber])
}

model MonthlyTarget {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  month               DateTime
  gaTarget            Int      @default(0)
  c2cTarget           Decimal  @default(0) @db.Decimal(18,2)
  scTarget            Decimal  @default(0) @db.Decimal(18,2)
  totalRechargeTarget Decimal  @default(0) @db.Decimal(18,2)
  ssoTarget           Int      @default(0)
  lsoTarget           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([month])
}

model ManualMetric {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      DateTime
  scAchieved Decimal  @default(0) @db.Decimal(18,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, month])
}

model ImportBatch {
  id           String       @id @default(cuid())
  type         ImportType
  fileName     String
  businessDate DateTime?
  uploadedAt   DateTime     @default(now())
  totalRows    Int          @default(0)
  successRows  Int          @default(0)
  failedRows   Int          @default(0)
  duplicateRows Int         @default(0)
  hash         String?      @unique
  status       ImportStatus @default(PROCESSING)
  errors       ImportError[]
  gaRecords    GaRecord[]
  gaActivations GaActivation[]
  c2cRecords   C2cRecord[]
  c2sRecords   C2sRecord[]
  obRecords    ObRecord[]
}

model ImportError {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  message   String
  rawData   Json?
  createdAt DateTime    @default(now())
}

model GaRecord {
  id         String       @id @default(cuid())
  retailerId String
  retailer   Retailer     @relation(fields: [retailerId], references: [id])
  date       DateTime
  gaCount    Int          @default(0)
  ga150      Int          @default(0)
  ga300      Int          @default(0)
  batchId    String?
  batch      ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt  DateTime     @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

model GaActivation {
  id             String       @id @default(cuid())
  simNo          String       @unique
  retailerId     String
  retailer       Retailer     @relation(fields: [retailerId], references: [id])
  activationDate DateTime
  activationTime String?
  sellingPrice   Decimal      @db.Decimal(10,2)
  batchId        String?
  batch          ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([activationDate])
  @@index([retailerId, activationDate])
  @@index([batchId])
}

model C2cRecord {
  id               String       @id @default(cuid())
  retailerId       String
  retailer         Retailer     @relation(fields: [retailerId], references: [id])
  date             DateTime
  transactionCount Int          @default(0)
  amount           Decimal      @default(0) @db.Decimal(18,2)
  batchId          String?
  batch            ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt        DateTime     @default(now())

  @@unique([retailerId, date])
  @@index([date])
}


model C2sRecord {
  id               String       @id @default(cuid())
  retailerId       String
  retailer         Retailer     @relation(fields: [retailerId], references: [id])
  date             DateTime
  transactionCount Int          @default(0)
  amount           Decimal      @default(0) @db.Decimal(18,2)
  enabled          Boolean?
  sellerStatus     String?
  batchId          String?
  batch            ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt        DateTime     @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

model ObRecord {
  id               String       @id @default(cuid())
  retailerId       String
  retailer         Retailer     @relation(fields: [retailerId], references: [id])
  date             DateTime
  transactionCount Int          @default(0)
  amount           Decimal      @default(0) @db.Decimal(18,2)
  batchId          String?
  batch            ImportBatch? @relation(fields: [batchId], references: [id])
  createdAt        DateTime     @default(now())

  @@unique([retailerId, date])
  @@index([date])
}

enum ImportType {
  GA
  C2C
  C2S
  OB
  EMPLOYEES
  RETAILERS
  TARGETS
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}



model BpAssignment {
  id         String   @id @default(cuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  active     Boolean  @default(true)
  gaTarget   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, active])
  @@index([retailerId, active])
  @@index([startDate])
}

model User {
  id             String       @id @default(cuid())
  displayName    String
  mobileNumber   String?      @unique
  username       String?      @unique
  credentialHash String
  role           UserRole
  active         Boolean      @default(true)
  employeeId     String?      @unique
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  supervisorId   String?      @unique
  supervisor     Supervisor?  @relation(fields: [supervisorId], references: [id])
  bpRetailerId   String?      @unique
  bpRetailer     Retailer?    @relation("BpRetailerUser", fields: [bpRetailerId], references: [id])
  sessions       Session[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
  ACCOUNTS
  RSO
  BP
}
